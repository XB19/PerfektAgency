# Copier ce fichier en ".env" à la racine du projet, puis compléter.
# Ne jamais publier le fichier .env.

# Base de données (créée automatiquement par Docker)
PGUSER=perfekt
PGPASSWORD=choisir_un_mot_de_passe_long
PGDATABASE=perfekt_academy

# Secret des sessions : une longue chaîne aléatoire
# (ex. : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=remplacer_par_une_longue_chaine_aleatoire

# Adresse publique du site (QR codes des attestations, emails, sitemap)
CLIENT_URL=https://www.votre-domaine.com
# Domaine pour le HTTPS automatique (profil "https")
DOMAIN=www.votre-domaine.com
# Port exposé sans HTTPS
APP_PORT=4000

MAX_DEVICES=2
# "simulation" tant que le prestataire de paiement n'est pas branché
PAYMENT_MODE=simulation
PAYMENT_WEBHOOK_SECRET=
