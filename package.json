{
  "name": "perfekt-agency-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "install:all": "npm --prefix server install && npm --prefix client install",
    "db:setup": "npm --prefix server run db:setup",
    "db:reset": "node server/src/db/setup.js --reset",
    "dev": "node scripts/dev.mjs",
    "build": "npm --prefix client run build",
    "start": "npm --prefix server start",
    "backup": "npm --prefix server run backup"
  }
}
